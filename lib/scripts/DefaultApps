# Default Applications style manager: set the default X terminal emulator,
# editor and file manager without editing NsCDE.conf by hand.
# Values are stored as "InfoStoreAdd <key> <command>" lines in
# $FVWM_USERDIR/NsCDE.conf and applied to the running session immediately.

UseGettext {$NSCDE_ROOT/share/locale;NsCDE-DefaultApps}
WindowLocaleTitle {Default Applications}
WindowSize 444 344
Colorset 22
Font xft::size=11

Init
Begin
   Set $NSCDEFILE = (GetOutput {echo $FVWM_USERDIR/NsCDE.conf} -1 1)

   # Read current values from NsCDE.conf (InfoStoreAdd lines)
   Set $CurrentTerm = (GetOutput {awk '/^InfoStoreAdd terminal /{print $3; exit}' $FVWM_USERDIR/NsCDE.conf} 0 0)
   Set $CurrentEditor = (GetOutput {awk '/^InfoStoreAdd xeditor /{print $3; exit}' $FVWM_USERDIR/NsCDE.conf} 0 0)
   Set $CurrentFilemgr = (GetOutput {awk '/^InfoStoreAdd filemgr /{print $3; exit}' $FVWM_USERDIR/NsCDE.conf} 0 0)

   If $CurrentTerm == {} Then
   Begin
      Set $CurrentTerm = (GetOutput {$NSCDE_TOOLSDIR/appfinder terminal terminal} 0 0)
   End

   ChangeValue 3 $CurrentTerm
   ChangeValue 7 $CurrentEditor
   ChangeValue 10 $CurrentFilemgr
End

Widget 1
   Property
   Size 436 336
   Position 4 4
   Type Rectangle
   Flags NoReliefString
   Main
      Case message of
      SingleClic :
      Begin
      End
End

