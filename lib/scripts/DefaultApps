# Buttons ---------------------------------------------------------------
Widget 11
   Property
   Size 96 0
   Position 16 294
   Type PushButton
   LocaleTitle {OK}
   Font "xft:::pixelsize=15"
   Flags NoReliefString Center
   Main
      Case message of
      SingleClic :
      Begin
         Set $TermCmd = (GetTitle 3)
         Set $EditorCmd = (GetTitle 7)
         Set $FilemgrCmd = (GetTitle 10)
         Set $TermFile = $NSCDEFILE
         Set $EditorFile = $NSCDEFILE
         Set $FilemgrFile = $NSCDEFILE

         # Terminal
         Exec exec sh -c "sed -i 's|^InfoStoreAdd terminal .*|InfoStoreAdd terminal $TermCmd|' $TermFile; grep -q '^InfoStoreAdd terminal ' $TermFile || echo 'InfoStoreAdd terminal $TermCmd' >> $TermFile; nscde_fvwmclnt 'InfoStoreAdd terminal $TermCmd'"
         # Editor
         Exec exec sh -c "sed -i 's|^InfoStoreAdd xeditor .*|InfoStoreAdd xeditor $EditorCmd|' $EditorFile; grep -q '^InfoStoreAdd xeditor ' $EditorFile || echo 'InfoStoreAdd xeditor $EditorCmd' >> $EditorFile; nscde_fvwmclnt 'InfoStoreAdd xeditor $EditorCmd'"
         # File Manager
         Exec exec sh -c "sed -i 's|^InfoStoreAdd filemgr .*|InfoStoreAdd filemgr $FilemgrCmd|' $FilemgrFile; grep -q '^InfoStoreAdd filemgr ' $FilemgrFile || echo 'InfoStoreAdd filemgr $FilemgrCmd' >> $FilemgrFile; nscde_fvwmclnt 'InfoStoreAdd filemgr $FilemgrCmd'"
         Quit
      End
End

