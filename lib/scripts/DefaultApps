Widget 4
   Property
   Size 70 0
   Position 356 18
   Type PopupMenu
   Value 0
   Flags NoReliefString
   LocaleTitle {xterm|alacritty|kitty|konsole|gnome-terminal|xfce4-terminal|wezterm}
   Font "xft:::pixelsize=13"
   Main
      Case message of
      SingleClic :
      Begin
         If (GetValue 4) == 1 Then ChangeValue 3 {xterm}
         If (GetValue 4) == 2 Then ChangeValue 3 {alacritty}
         If (GetValue 4) == 3 Then ChangeValue 3 {kitty}
         If (GetValue 4) == 4 Then ChangeValue 3 {konsole}
         If (GetValue 4) == 5 Then ChangeValue 3 {gnome-terminal}
         If (GetValue 4) == 6 Then ChangeValue 3 {xfce4-terminal}
         If (GetValue 4) == 7 Then ChangeValue 3 {wezterm}
      End
End

