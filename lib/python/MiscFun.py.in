import os.path
import subprocess
import sys
import os
import gettext

_LOCALE_DIR = os.path.normpath(os.path.join("@NSCDE_DATADIR@", os.pardir, "locale"))
_ = gettext.translation("NsCDE", localedir=_LOCALE_DIR, fallback=True).gettext

def execWithShell1(cmd):
    print (cmd)
    #cmd='echo hello'
    print (subprocess.check_output(cmd, shell=True))

#this also seems to introduce quite a delay
def execWithShell(cmd):
    try:
        output=subprocess.check_output(cmd, shell=True)
    except subprocess.CalledProcessError as e:
        print (cmd)
        print (_('ERROR'))
        print (e.output)
        output=''
    return output
def execWithShellThread(cmd):
        try:
            p=subprocess.Popen(cmd,shell=True)
        except OSError as e:
            print (cmd)
            print (_('ERROR'))
            print (e)
            p=''
        return p
def checkFile(filename):
    if os.path.isfile(filename):
        return filename
    else:
        print (_('FILE NOT FOUND: %s') % filename)
        sys.exit(1)
def checkDir(filename):
    if os.path.isdir(filename):
        return filename
    else:
        print (_('DIRECTORY NOT FOUND: %s') % filename)
        sys.exit(1)
