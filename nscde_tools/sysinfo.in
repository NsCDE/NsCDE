import platform
import os
import pwd
import socket
import gettext

_LOCALE_BASE = os.environ.get("NSCDE_DATADIR") or "@NSCDE_DATADIR@"
_LOCALE_DIR = os.path.normpath(os.path.join(_LOCALE_BASE, os.pardir, "locale"))
_ = gettext.translation("nscde-tools", localedir=_LOCALE_DIR, fallback=True).gettext

# User Name
print (pwd.getpwuid(os.getuid()).pw_name)

# Workstation Name
print (platform.node().split(".", 1)[0])

# Uname mpi
print (platform.processor(), platform.machine(), os.uname()[4])

try:
    # Internet (IP) Address
    print (socket.gethostbyname(socket.gethostname()))
except:
    print (_("(none)"))

# Internet Domain
try:
    finddomain = socket.getfqdn(socket.gethostbyname(socket.gethostname()))
    domainpart = finddomain.split(".", 1)[1]
    print (domainpart)
except:
    print (_("(none)"))

try:
   import psutil

   physmem_mb = int(psutil.virtual_memory()[0] / 1024 / 1024)
   swapmem_mb = int(psutil.swap_memory()[0] / 1024 / 1024)
   swapmem_avail = int(psutil.swap_memory()[2] / 1024 / 1024)
   swapmem_pct = int(psutil.swap_memory()[3] / 1024 / 1024)

   # Physical Memory (RAM)
   print (physmem_mb)

   # Virtual Memory (Swap)
   print (swapmem_mb)

   # Virtual Memory (Swap) percent
   print (swapmem_pct)

   # Virtual Memory in Use
   print (str(swapmem_pct) + "% " + "(" + str(swapmem_pct) + "/" + str(swapmem_mb) + ") " + str(swapmem_avail) + "MB")

except ImportError:
   physmem_mb = _("(Not available)")
   swapmem_mb = _("(Not available)")
   swapmem_avail = _("(Not available)")
   swapmem_pct = _("(Not available)")

   # Physical Memory (RAM)
   print (physmem_mb)

   # Virtual Memory (Swap)
   print (swapmem_mb)

   # Virtual Memory (Swap) percent
   print (swapmem_pct)

   # Virtual Memory in Use
   print (_("(Not available)"))

