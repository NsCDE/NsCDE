msgstr "图标从上到下靠右放置"

msgid "Default Icon Size"
msgstr "默认图标大小"

msgid "Maximum Icon Size"
msgstr "最大图标大小"

msgid "Desk Page Edges"
msgstr "桌面页面边缘"

