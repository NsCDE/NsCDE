# BackdropMgr
msgid "Style Manager - Window"
msgstr "样式管理器 - 窗口"

msgid "Default"
msgstr "默认"

msgid "Configuration Section: "
msgstr "配置节： "

msgid " Window Behavior| Window Icons| Page Edges| Animation"
msgstr " 窗口行为| 窗口图标| 页面边缘| 动画"

msgid "Window Behavior"
msgstr "窗口行为"

msgid "Only Pointer Inside Window Makes Focus"
msgstr "仅指针位于窗口内时聚焦"

msgid "Point In Window To Make Active"
msgstr "指针进入窗口即激活"

msgid "Click In Window To Make Active"
msgstr "单击窗口即激活"

msgid " Raise Window When Made Active        "
msgstr " 激活时提升窗口        "

msgid " Allow Primary Windows On Top            "
msgstr " 允许主窗口置顶            "

msgid " Lower Transient With Primary Window"
msgstr " 主窗口降低时附属窗口随之降低"

msgid " Raise/Lower Primaries With Transients"
msgstr " 主窗口与附属窗口一同提升/降低"

msgid " Show Contents During Move              "
msgstr " 移动时显示内容              "

msgid "Time After Which Active Window Is Raised"
msgstr "激活窗口自动提升延迟"

msgid "Manual Window Movement Threshold"
msgstr "手动移动窗口阈值"

msgid "Window Icons"
msgstr "窗口图标"

msgid "Use Icon Box"
msgstr "使用图标框"

msgid "Place On Workspace"
msgstr "放置到工作区"

